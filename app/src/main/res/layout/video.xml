<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/da_oscuro">

	<!-- Video de la cámara (el recuadro del rostro se dibuja encima) -->
	<SurfaceView
		android:id="@+id/video"
		android:layout_width="match_parent"
		android:layout_height="match_parent" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical">

		<LinearLayout style="@style/DaTopbar">
			<ImageView style="@style/DaLogo" />
			<View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
			<ImageView
				android:id="@+id/switch_camera"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:layout_marginLeft="6dp"
				android:layout_marginStart="6dp"
				android:padding="8dp"
				android:src="@drawable/ic_da_camara"
				android:tint="@color/da_texto_2"
				android:contentDescription="@string/hint_witch_camera" />
			<ImageView
				android:id="@+id/func"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:padding="8dp"
				android:src="@drawable/ic_da_ajustes"
				android:tint="@color/da_texto_2"
				android:contentDescription="@string/title_func" />
		</LinearLayout>

		<!-- Sentido y carril: el operador los cambia tocando -->
		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="12dp"
			android:orientation="horizontal"
			android:padding="4dp"
			android:elevation="3dp"
			android:background="@drawable/da_pill_blanca">
			<TextView
				android:id="@+id/txtSentidoVideo"
				style="@style/DaPill"
				android:background="@drawable/da_pill_entrada"
				android:text="@string/sentido_entrada"
				android:textColor="@color/da_verde_texto" />
			<TextView
				android:id="@+id/txtCarrilVideo"
				style="@style/DaPill"
				android:layout_marginLeft="6dp"
				android:layout_marginStart="6dp"
				android:background="@drawable/da_pill_peatonal"
				android:text="@string/pill_peatonal"
				android:textColor="@color/da_azul" />
		</LinearLayout>

		<!-- Punto (o FPS en modo depuración) -->
		<TextView
			android:id="@+id/txtTitle"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="12dp"
			android:paddingLeft="14dp"
			android:paddingRight="14dp"
			android:paddingTop="6dp"
			android:paddingBottom="6dp"
			android:background="@drawable/da_pill_oscura"
			android:textColor="#FFFFFFFF"
			android:textSize="14sp"
			android:fontFamily="@font/inter_semibold" />

		<View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

		<TextView
			android:id="@+id/txtStat"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:layout_marginBottom="16dp"
			android:paddingLeft="16dp"
			android:paddingRight="16dp"
			android:paddingTop="8dp"
			android:paddingBottom="8dp"
			android:background="@drawable/da_pill_oscura"
			android:text="@string/mire_pantalla"
			android:textColor="#FFFFFFFF"
			android:textSize="16sp"
			android:fontFamily="@font/inter_semibold" />

		<!-- Resultado -->
		<LinearLayout
			android:id="@+id/cardResultadoVideo"
			style="@style/DaCard"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginLeft="16dp"
			android:layout_marginRight="16dp"
			android:layout_marginBottom="24dp"
			android:padding="16dp"
			android:orientation="horizontal"
			android:gravity="center_vertical"
			android:visibility="gone">
			<ImageView
				android:id="@+id/ivResVideo"
				style="@style/DaIconBox"
				android:layout_width="60dp"
				android:layout_height="60dp"
				android:background="@drawable/da_icbox_ok"
				android:src="@drawable/ic_da_check" />
			<LinearLayout
				android:layout_width="0dp"
				android:layout_weight="1"
				android:layout_height="wrap_content"
				android:layout_marginLeft="14dp"
				android:layout_marginStart="14dp"
				android:orientation="vertical">
				<TextView
					android:id="@+id/txtResLinea1"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textColor="@color/da_verde_texto"
					android:textSize="15sp"
					android:fontFamily="@font/inter_extrabold" />
				<TextView
					android:id="@+id/txtResNombre"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textColor="@color/da_texto"
					android:textSize="18sp"
					android:fontFamily="@font/inter_bold" />
				<TextView
					android:id="@+id/txtResDetalle"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textColor="@color/da_texto_2"
					android:textSize="13sp" />
			</LinearLayout>
		</LinearLayout>

		<!-- Cambiar a cédula: cierra la cámara para liberar el lector 2D -->
		<LinearLayout
			android:id="@+id/btnUsarCedula"
			style="@style/DaBotonPrimario"
			android:layout_width="match_parent"
			android:layout_marginLeft="16dp"
			android:layout_marginRight="16dp"
			android:layout_marginBottom="16dp">
			<ImageView style="@style/DaBotonIcono" android:src="@drawable/ic_da_cedula" />
			<TextView style="@style/DaBotonTexto" android:text="@string/usar_cedula" />
		</LinearLayout>

		<!-- Fecha y hora (ocultas en este diseño; el código las sigue actualizando) -->
		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:visibility="gone">
			<TextView android:id="@+id/txtTime" android:layout_width="wrap_content" android:layout_height="wrap_content" />
			<TextView android:id="@+id/txtWeek" android:layout_width="wrap_content" android:layout_height="wrap_content" />
			<TextView android:id="@+id/txtDate" android:layout_width="wrap_content" android:layout_height="wrap_content" />
		</LinearLayout>
	</LinearLayout>
</FrameLayout>
