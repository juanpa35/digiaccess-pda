<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="@drawable/da_bg_morado">

	<include layout="@layout/da_encabezado" />

	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:fillViewport="true">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:gravity="center"
			android:padding="20dp">

			<LinearLayout
				style="@style/DaCard"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:gravity="center_horizontal"
				android:padding="24dp">

				<ImageView
					style="@style/DaIconBox"
					android:layout_width="72dp"
					android:layout_height="72dp"
					android:padding="18dp"
					android:background="@drawable/da_icbox_azul"
					android:src="@drawable/ic_da_candado" />

				<TextView
					android:id="@+id/txtPasswordPrompt"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="16dp"
					android:text="@string/title_password"
					android:textColor="@color/da_texto"
					android:textSize="21sp"
					android:fontFamily="@font/inter_bold" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:gravity="center"
					android:text="@string/clave_ayuda"
					android:textColor="@color/da_texto_2"
					android:textSize="14sp" />

				<EditText
					android:id="@+id/txtPassword"
					style="@style/DaCampo"
					android:layout_height="54dp"
					android:layout_marginTop="20dp"
					android:gravity="center"
					android:hint="@string/hint_password"
					android:inputType="textPassword"
					android:letterSpacing="0.2"
					android:textSize="20sp"
					android:autofillHints=""
					android:text="" />

				<Button android:id="@+id/btnOK" style="@style/DaBotonPlanoPrimario" android:layout_marginTop="18dp" android:text="@string/ingresar" />
				<Button android:id="@+id/btnCancel" style="@style/DaBotonPlanoClaro" android:layout_marginTop="10dp" android:text="@string/cancel" />
			</LinearLayout>
		</LinearLayout>
	</ScrollView>
</LinearLayout>
