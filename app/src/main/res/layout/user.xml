<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="@color/da_fondo_claro">

	<include layout="@layout/da_encabezado" />

	<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:padding="16dp">

		<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rostro_titulo" android:textColor="@color/da_texto" android:textSize="22sp" android:fontFamily="@font/inter_bold" />
		<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/rostro_ayuda" android:textColor="@color/da_texto_2" android:textSize="13sp" />

		<LinearLayout
			style="@style/DaCard"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="14dp"
			android:elevation="2dp"
			android:orientation="vertical"
			android:padding="16dp">

			<!-- Foto -->
			<FrameLayout
				android:layout_width="180dp"
				android:layout_height="225dp"
				android:layout_gravity="center_horizontal"
				android:background="@drawable/da_foto_marco">
				<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
					<ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_da_usuario" android:tint="@color/da_texto_3" android:importantForAccessibility="no" />
					<TextView android:id="@+id/txtPhoto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/foto_pendiente" android:textColor="@color/da_texto_3" android:textSize="13sp" />
				</LinearLayout>
				<ImageView
					android:id="@+id/imgPhoto"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:scaleType="centerCrop"
					android:visibility="invisible"
					android:contentDescription="@string/prompt_userphoto" />
			</FrameLayout>

			<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
				<Button android:id="@+id/btnPhoto" style="@style/DaBotonPlanoPrimario" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/prompt_takephoto" />
				<View android:layout_width="10dp" android:layout_height="1dp" />
				<Button android:id="@+id/btnPicture" style="@style/DaBotonPlanoClaro" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/galeria" />
			</LinearLayout>

			<TextView android:id="@+id/txtNoPrompt" style="@style/DaEtiqueta" android:text="@string/fila_cedula" />
			<EditText
				android:id="@+id/txtNo"
				style="@style/DaCampo"
				android:hint="@string/hint_no"
				android:inputType="number"
				android:autofillHints="" />

			<TextView android:id="@+id/txtNamePrompt" style="@style/DaEtiqueta" android:text="@string/nombre" />
			<EditText
				android:id="@+id/txtName"
				style="@style/DaCampo"
				android:hint="@string/hint_name"
				android:inputType="textCapWords"
				android:autofillHints="" />

			<!-- Tarjeta: no se usa en DIGIACCESS -->
			<TextView android:id="@+id/txtCardPrompt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:text="@string/prompt_card" />
			<EditText android:id="@+id/txtCard" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:enabled="false" android:inputType="number" android:autofillHints="" />
		</LinearLayout>
	</LinearLayout>
	</ScrollView>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:padding="16dp"
		android:background="#FFFFFFFF"
		android:elevation="6dp">
		<Button android:id="@+id/btnCancel" style="@style/DaBotonPlanoClaro" android:layout_width="0dp" android:layout_weight="1" android:text="@string/cancel" />
		<View android:layout_width="10dp" android:layout_height="1dp" />
		<Button android:id="@+id/btnOK" style="@style/DaBotonPlanoPrimario" android:layout_width="0dp" android:layout_weight="1" android:text="@string/save" />
	</LinearLayout>
</LinearLayout>
