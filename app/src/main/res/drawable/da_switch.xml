<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:state_checked="true">
		<layer-list>
			<item><shape android:shape="rectangle"><solid android:color="#FF10B981" /><corners android:radius="15dp" /><size android:width="52dp" android:height="30dp" /></shape></item>
			<item android:left="25dp" android:right="3dp" android:top="3dp" android:bottom="3dp"><shape android:shape="oval"><solid android:color="#FFFFFFFF" /></shape></item>
		</layer-list>
	</item>
	<item android:state_checked="false">
		<layer-list>
			<item><shape android:shape="rectangle"><solid android:color="#FFD1D5DB" /><corners android:radius="15dp" /><size android:width="52dp" android:height="30dp" /></shape></item>
			<item android:left="3dp" android:right="25dp" android:top="3dp" android:bottom="3dp"><shape android:shape="oval"><solid android:color="#FFFFFFFF" /></shape></item>
		</layer-list>
	</item>
</selector>
